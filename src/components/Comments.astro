---
import giscusTheme from "../../public/giscus-theme.css?raw"

// Giscus comments backed by GitHub Discussions on the blog repo.
// IDs come from https://giscus.app.
const GISCUS_CATEGORY_ID = "DIC_kwDORbXaxc4DKFrp"
// Chrome blocks the giscus.app iframe from fetching localhost, so in dev the theme is inlined.
const GISCUS_THEME_URL = import.meta.env.DEV
  ? `data:text/css,${encodeURIComponent(giscusTheme)}`
  : new URL("/giscus-theme.css", Astro.site).href
---

<section class="comments">
  <script
    is:inline
    data-astro-rerun
    src="https://giscus.app/client.js"
    data-repo="nathanbabcock/blog"
    data-repo-id="R_kgDORbXaxQ"
    data-category="Announcements"
    data-category-id={GISCUS_CATEGORY_ID}
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={GISCUS_THEME_URL}
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<style>
  .comments {
    margin-top: var(--spacing-xl);
  }
</style>
