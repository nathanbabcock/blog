---
// Giscus comments backed by GitHub Discussions on the blog repo.
// IDs come from https://giscus.app.
const GISCUS_CATEGORY_ID = "DIC_kwDORbXaxc4DKFrp"
---

<section class="comments">
  <script
    is:inline
    data-astro-rerun
    src="https://giscus.app/client.js"
    data-repo="nathanbabcock/blog"
    data-repo-id="R_kgDORbXaxQ"
    data-category="Announcements"
    data-category-id={GISCUS_CATEGORY_ID}
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="dark_dimmed"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<style>
  .comments {
    margin-top: var(--spacing-xl);
  }
</style>
