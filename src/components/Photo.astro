---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt: string
  /** Use "eager" for a photo above the fold */
  loading?: "lazy" | "eager"
}

const { src, alt, loading = "lazy" } = Astro.props
---

<figure>
  <a href={src.src} target="_blank" rel="noopener noreferrer">
    <Image src={src} alt={alt} loading={loading} />
  </a>
  <figcaption><slot /></figcaption>
</figure>

<style>
  figure {
    --radius: 6px;
    --ring-width: 1px;
    --ring-gap: 8px;

    margin: var(--spacing-lg) 0;
  }

  figure > a {
    display: block;
  }

  /* Accent ring with a gap, as border + padding so it sits flush with the text column.
     Images are clipped to their content-box curve, so the photo keeps its own radius inside. */
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    padding: var(--ring-gap);
    border: var(--ring-width) solid var(--color-accent);
    border-radius: calc(var(--radius) + var(--ring-width) + var(--ring-gap));
  }

  /* Matches the diagram captions */
  figcaption {
    margin-top: var(--spacing-sm);
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.35;
    color: var(--color-muted);
    text-align: center;
  }

  figcaption :global(p) {
    margin: 0;
  }
</style>
