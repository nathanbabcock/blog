---
import Diagram from "../Diagram.astro"
import PageMockup from "./PageMockup.astro"

const chips = ["Hero", "RichText", "Section", "Heading", "Carousel"]
const chipWidth = (name: string) => name.length * 7.8 + 18
const chipX = chips.map((_, i) => 156 + chips.slice(0, i).reduce((x, c) => x + chipWidth(c) + 8, 0))

const pageY = 412
---

<Diagram caption="One library of blocks, rendered into the same page twice: static in production, hydrated in live preview.">
  <svg
    viewBox="0 0 720 822"
    role="img"
    aria-label="CMS content JSON feeds a library of shared React blocks, which renders two pages side by side with the same blocks in the same layout. In production the page is static HTML. In live preview the whole page is wrapped in one client island and every block is hydrated."
  >
    <defs>
      <!-- refX at the base: paths end where the arrowhead begins -->
      <marker id="rp-arrow" viewBox="0 0 10 10" refX="0" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrowhead" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
    </defs>

    <!-- CMS content -->
    <rect class="box" x="230" y="0" width="260" height="244" rx="6"></rect>
    <text class="title" x="246" y="26">Raw CMS content JSON</text>
    <g class="json">
      <text class="mono" x="246" y="54"><tspan class="p">{"{"}</tspan></text>
      <text class="mono" x="246" y="70">  "type": <tspan class="s">"page"</tspan><tspan class="p">,</tspan></text>
      <text class="mono" x="246" y="86">  "blocks": <tspan class="p">[</tspan></text>
      <text class="mono" x="246" y="102"><tspan class="p">    {"{"}</tspan> "type": <tspan class="s">"hero"</tspan> <tspan class="p">{"},"}</tspan></text>
      <text class="mono" x="246" y="118"><tspan class="p">    {"{"}</tspan> "type": <tspan class="s">"richText"</tspan> <tspan class="p">{"},"}</tspan></text>
      <text class="mono" x="246" y="134"><tspan class="p">    {"{"}</tspan> "type": <tspan class="s">"section"</tspan><tspan class="p">,</tspan></text>
      <text class="mono" x="246" y="150">      "blocks": <tspan class="p">[</tspan></text>
      <text class="mono" x="246" y="166"><tspan class="p">        {"{"}</tspan> "type": <tspan class="s">"heading"</tspan> <tspan class="p">{"},"}</tspan></text>
      <text class="mono" x="246" y="182"><tspan class="p">        {"{"}</tspan> "type": <tspan class="s">"carousel"</tspan> <tspan class="p">{"}"}</tspan></text>
      <text class="mono" x="246" y="198"><tspan class="p">      ] {"}"}</tspan></text>
      <text class="mono" x="246" y="214"><tspan class="p">  ]</tspan></text>
      <text class="mono" x="246" y="230"><tspan class="p">{"}"}</tspan></text>
    </g>

    <path class="edge" d="M360,245 L360,269" marker-end="url(#rp-arrow)"></path>

    <!-- Library -->
    <rect class="box" x="140" y="278" width="440" height="78" rx="6"></rect>
    <text class="title" x="156" y="304">Library of React components</text>
    {
      chips.map((name, i) => (
        <>
          <rect class="box" x={chipX[i]} y="318" width={chipWidth(name)} height="24" rx="4" />
          <text class="mono" x={chipX[i] + 9} y="334">
            {name}
          </text>
        </>
      ))
    }

    <!-- Fork: curves settle into a straight vertical run before each arrowhead -->
    <path class="edge" d="M300,357 C300,380 200,374 200,392 L200,403" marker-end="url(#rp-arrow)"></path>
    <path class="edge" d="M420,357 C420,380 520,374 520,392 L520,403" marker-end="url(#rp-arrow)"></path>

    <!-- Pages -->
    <PageMockup
      x={60}
      y={pageY}
      url="example.com"
      title="Production"
      notes={["static HTML, no JS", "content fetched at build"]}
    />
    <PageMockup
      x={380}
      y={pageY}
      url="cms editor · preview"
      title="Live preview"
      notes={["one island, all hydrated", "content via postMessage"]}
      accent
      islands={["page"]}
    />
  </svg>
</Diagram>
