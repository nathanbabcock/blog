---
import Diagram from "../Diagram.astro"
import JsonSnippet from "./JsonSnippet.astro"
import PageMockup from "./PageMockup.astro"

const chips = ["Hero", "RichText", "Section", "Heading", "Carousel"]
const chipWidth = (name: string) => name.length * 7.8 + 18
const chipX = chips.map((_, i) => 160 + chips.slice(0, i).reduce((x, c) => x + chipWidth(c) + 8, 0))

const pageY = 416
---

<Diagram caption="One library of blocks, rendered into the same page twice: static in production, hydrated in live preview.">
  <svg
    viewBox="0 -11 720 841"
    role="img"
    aria-label="CMS content JSON feeds a library of shared React blocks, which renders two pages side by side with the same blocks in the same layout. In production the page is static HTML. In live preview the whole page is wrapped in one client island and every block is hydrated."
  >
    <defs>
      <!-- refX at the base: paths end where the arrowhead begins -->
      <marker id="rp-arrow" viewBox="0 0 10 10" refX="0" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrowhead" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
    </defs>

    <!-- CMS content -->
    <JsonSnippet x={230} y={28} />

    <!-- Off-center so it clears the library label; lines up with the live preview fork below -->
    <path class="edge" d="M420,249 L420,293" marker-end="url(#rp-arrow)"></path>

    <!-- Library -->
    <text class="title" x="140" y="290">Library of React components</text>
    <rect class="box" x="140" y="302" width="440" height="58" rx="6"></rect>
    {
      chips.map((name, i) => (
        <>
          <rect class="box" x={chipX[i]} y="319" width={chipWidth(name)} height="24" rx="4" />
          <text class="mono" x={chipX[i] + 9} y="335">
            {name}
          </text>
        </>
      ))
    }

    <!-- Fork: curves settle into a straight vertical run before each arrowhead -->
    <path class="edge" d="M300,361 C300,384 200,378 200,396 L200,407" marker-end="url(#rp-arrow)"></path>
    <path class="edge" d="M420,361 C420,384 520,378 520,396 L520,407" marker-end="url(#rp-arrow)"></path>

    <!-- Pages -->
    <PageMockup
      x={60}
      y={pageY}
      url="example.com"
      title="Production"
      notes={["static HTML, no JS", "content fetched at build"]}
    />
    <PageMockup
      x={380}
      y={pageY}
      url="cms editor · preview"
      title="Live preview"
      notes={["one island, all hydrated", "content via postMessage"]}
      accent
      islands={["page"]}
    />
  </svg>
</Diagram>
