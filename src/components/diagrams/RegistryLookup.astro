---
import Diagram from "../Diagram.astro"
import JsonSnippet from "./JsonSnippet.astro"
import PageMockup from "./PageMockup.astro"

const jsonY = 16
const pageX = 440

// Each block type: its JSON line, and where its label sits in the page mockup
const lookups = [
  { type: "hero", line: 3, pageY: 56, blockX: pageX + 12 },
  { type: "richText", line: 4, pageY: 101, blockX: pageX + 12 },
  { type: "section", line: 5, pageY: 163, blockX: pageX + 12 },
  { type: "heading", line: 7, pageY: 195, blockX: pageX + 24 },
  { type: "carousel", line: 8, pageY: 235, blockX: pageX + 24 },
]
const jsonLineY = (k: number) => jsonY + 54 + k * 16 - 4
---

<Diagram caption="Every block type, top-level or nested, is resolved through the same registry.">
  <svg
    viewBox="0 0 720 366"
    role="img"
    aria-label="Each block type in the CMS content JSON is looked up in the registry, which maps it to a component on the rendered page. The heading and carousel nested inside the section go through the same registry and land inside the Section block."
  >
    <JsonSnippet x={0} y={jsonY} width={240} />

    <!-- Drawn first so the connectors sit on top of the page -->
    <PageMockup x={pageX} url="example.com" title="Rendered page" />

    <!-- Registry: one row per block type, aligned with the block it renders -->
    <text class="mono" x="345" y="26" text-anchor="middle">registry</text>
    <rect class="box" x="290" y="36" width="110" height="282" rx="6"></rect>
    {
      lookups.map(({ type, line, pageY, blockX }) => {
        const ly = jsonLineY(line)
        return (
          <>
            <path class="edge" d={`M241,${ly} C268,${ly} 270,${pageY} 290,${pageY} L298,${pageY}`} />
            <rect class="box" x="298" y={pageY - 12} width="94" height="24" rx="4" />
            <text class="mono" x="345" y={pageY + 4} text-anchor="middle">
              {type}
            </text>
            <path class="edge" d={`M392,${pageY} L${blockX},${pageY}`} />
          </>
        )
      })
    }
  </svg>
</Diagram>
