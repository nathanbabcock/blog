---
import Diagram from "../Diagram.astro"
import PageMockup from "./PageMockup.astro"
---

<Diagram caption="Server within client within server: the carousel hydrates, but its slide content arrives as static HTML.">
  <svg
    viewBox="0 -16 720 412"
    role="img"
    aria-label="The same page side by side. In production the carousel is a client island, but the rich text block inside its slide is rendered statically by Astro and passed in through a slot, so it stays static HTML. In live preview the whole page is still one island with every block hydrated."
  >
    <PageMockup
      x={60}
      url="example.com"
      title="Production"
      notes={["Carousel island with static slide content"]}
      islands={["carousel"]}
      slots={["slide"]}
    />
    <PageMockup
      x={380}
      url="cms editor · preview"
      title="Live preview"
      notes={["one hydrated island, fed by postMessage"]}
      accent
      islands={["page"]}
    />
  </svg>
</Diagram>
