---
import Diagram from "../Diagram.astro"

const used = ["Section", "Heading", "RichText", "Carousel"]
const waste = ["Hero", "VideoPlayer", "ShaderCanvas", "Calculator", "MapEmbed"]
const barY = (i: number) => 104 + i * 28
---

<Diagram caption="An interactive block that resolves its own children drags the entire registry into the client bundle.">
  <svg
    viewBox="0 0 720 352"
    role="img"
    aria-label="A page tree where the section block is a client island that imports the registry. Everything under it becomes client-rendered, and the page bundle contains every component in the registry, including several not used on the page."
  >
    <defs>
      <marker id="rl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrowhead" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
      <pattern id="rl-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#8a7e72" stroke-opacity="0.35" stroke-width="2"></line>
      </pattern>
    </defs>

    <!-- Edges -->
    <path class="edge" d="M265,44 L265,62 L70,62 L70,92"></path>
    <path class="edge" d="M265,62 L190,62 L190,92"></path>
    <path class="edge" d="M265,62 L400,62 L400,92"></path>
    <path class="edge" d="M400,140 L400,170 L290,170 L290,200"></path>
    <path class="edge" d="M400,170 L400,200"></path>
    <path class="edge" d="M400,170 L510,170 L510,200"></path>

    <!-- Server-rendered nodes -->
    <rect class="box" x="215" y="8" width="100" height="36" rx="5"></rect>
    <text x="265" y="31" text-anchor="middle">page</text>
    <rect class="box" x="20" y="92" width="100" height="36" rx="5"></rect>
    <text x="70" y="115" text-anchor="middle">hero</text>
    <rect class="box" x="140" y="92" width="100" height="36" rx="5"></rect>
    <text x="190" y="115" text-anchor="middle">richText</text>

    <!-- Client island: section and everything beneath it -->
    <rect class="boundary" x="226" y="80" width="348" height="196" rx="8"></rect>
    <rect class="box client" x="340" y="92" width="120" height="48" rx="5"></rect>
    <text x="400" y="113" text-anchor="middle">section</text>
    <text class="sub accent" x="400" y="130" text-anchor="middle">imports registry</text>

    <rect class="box client" x="240" y="200" width="100" height="36" rx="5"></rect>
    <text x="290" y="223" text-anchor="middle">heading</text>
    <rect class="box client" x="350" y="200" width="100" height="36" rx="5"></rect>
    <text x="400" y="223" text-anchor="middle">richText</text>
    <rect class="box client" x="460" y="200" width="100" height="36" rx="5"></rect>
    <text x="510" y="223" text-anchor="middle">carousel</text>

    <text class="sub accent" x="240" y="264">client island: whole branch hydrates</text>

    <path class="edge" d="M576,178 L594,178" marker-end="url(#rl-arrow)"></path>

    <!-- Bundle -->
    <text class="title" x="598" y="90">page bundle</text>
    {
      used.map((name, i) => (
        <>
          <rect class="bar-used" x="598" y={barY(i)} width="122" height="22" rx="3" />
          <text class="mono" x="606" y={barY(i) + 15}>
            {name}
          </text>
        </>
      ))
    }
    {
      waste.map((name, i) => (
        <>
          <rect
            class="bar-waste"
            x="598"
            y={barY(used.length + i)}
            width="122"
            height="22"
            rx="3"
            fill="url(#rl-hatch)"
          />
          <text class="mono sub" x="606" y={barY(used.length + i) + 15}>
            {name}
          </text>
        </>
      ))
    }

    <!-- Legend -->
    <rect class="bar-used" x="240" y="300" width="14" height="14" rx="2"></rect>
    <text class="sub" x="262" y="312">needed on this page</text>
    <rect class="bar-waste" x="400" y="300" width="14" height="14" rx="2" fill="url(#rl-hatch)"></rect>
    <text class="sub" x="422" y="312">shipped anyway</text>
  </svg>
</Diagram>
