---
import Diagram from "../Diagram.astro"

const blocks = [
  { name: "Carousel", needed: true },
  { name: "RichText", needed: true },
  { name: "Hero" },
  { name: "Section" },
  { name: "Heading" },
  { name: "VideoPlayer", dep: "hls.js" },
  { name: "ShaderCanvas", dep: "three" },
  { name: "Calculator", dep: "mathjs" },
  { name: "MapEmbed", dep: "leaflet" },
]
const rowY = (i: number) => 40 + i * 40
const rowCy = (i: number) => rowY(i) + 15
const stackTop = rowY(0)
const stackBottom = rowY(blocks.length - 1) + 30
const stackMid = (stackTop + stackBottom) / 2
---

<Diagram caption="Rich text loops back to the registry, pulling every block into the bundle.">
  <svg
    viewBox="0 0 720 452"
    role="img"
    aria-label="Module graph. The registry imports every CMS block. The Carousel client island imports RichText for its slide content, and RichText imports the registry to render embedded blocks, which closes a loop back through every block and its dependencies. Everything ends up in the client bundle, though the page only needs Carousel and RichText."
  >
    <defs>
      <marker id="rl-arrow" viewBox="0 0 10 10" refX="0" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrowhead" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
      <marker id="rl-arrow-accent" viewBox="0 0 10 10" refX="0" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrowhead accent" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
    </defs>

    <rect class="boundary" x="0" y="0" width="720" height="410" rx="8"></rect>
    <text class="sub accent" x="16" y="24">client bundle</text>

    <!-- Registry spans the whole stack, so every import is a straight line -->
    <rect class="box bad" x="40" y={stackTop} width="160" height={stackBottom - stackTop} rx="5"></rect>
    <text class="mono" x="120" y={stackMid - 4} text-anchor="middle">registry</text>
    <text class="sub" x="120" y={stackMid + 16} text-anchor="middle">imports every block</text>

    {
      blocks.map(({ name, needed, dep }, i) => {
        const y = rowY(i)
        const cy = rowCy(i)
        return (
          <>
            {name === "RichText" ? (
              <path class="edge accent" d={`M289,${cy} L210,${cy}`} marker-end="url(#rl-arrow-accent)" />
            ) : (
              <path
                class={name === "Carousel" ? "edge accent" : "edge"}
                d={`M201,${cy} L280,${cy}`}
                marker-end={name === "Carousel" ? "url(#rl-arrow-accent)" : "url(#rl-arrow)"}
              />
            )}
            <rect class={needed ? "box client" : "box bad"} x="290" y={y} width="160" height="30" rx="4" />
            <text class="mono" x="302" y={cy + 5}>
              {name}
            </text>
            {dep && (
              <>
                <path class="edge" d={`M451,${cy} L521,${cy}`} marker-end="url(#rl-arrow)" />
                <rect class="box bad" x="530" y={y} width="150" height="30" rx="4" />
                <text class="mono sub" x="542" y={cy + 5}>
                  {dep}
                </text>
              </>
            )}
          </>
        )
      })
    }

    <!-- Warning on the import that closes the loop -->
    <g transform={`translate(245, ${rowCy(1)})`}>
      <path class="warn" d="M0,-10 L10,7 L-10,7 Z"></path>
      <text class="warn-mark" x="0" y="5" text-anchor="middle">!</text>
    </g>

    <!-- Carousel renders RichText for its slides -->
    <path
      class="edge accent"
      d={`M451,${rowCy(0)} C482,${rowCy(0)} 482,${rowCy(1)} 468,${rowCy(1)} L460,${rowCy(1)}`}
      marker-end="url(#rl-arrow-accent)"></path>

    <!-- Legend -->
    <rect class="box client" x="16" y="428" width="14" height="14" rx="2"></rect>
    <text class="sub" x="38" y="440">needed on this page</text>
    <rect class="box bad" x="200" y="428" width="14" height="14" rx="2"></rect>
    <text class="sub" x="222" y="440">unused but pulled in through the registry</text>
  </svg>
</Diagram>
