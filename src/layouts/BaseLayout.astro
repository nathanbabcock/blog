---
import "../styles/global.css"
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import Footer from "../components/Footer.astro"
import { GITHUB_URL, LINKEDIN_URL } from "../config"
import type { BlogPosting, Person, WebSite, WithContext } from "schema-dts"

interface Props {
  title: string
  description?: string
  ogImage?: string
  publishedTime?: Date
}

const { title, description = "Web dev blog", ogImage, publishedTime } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(ogImage ?? "/og/index.png", Astro.site)
const author = {
  "@type": "Person",
  name: "Nathan Babcock",
  url: new URL("/", Astro.site).href,
  sameAs: [GITHUB_URL, LINKEDIN_URL],
} as const satisfies Person
const jsonLd = publishedTime
  ? ({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: publishedTime.toISOString(),
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      image: ogImageURL.href,
      author,
    } as const satisfies WithContext<BlogPosting>)
  : ({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: title,
      description,
      url: canonicalURL.href,
      author,
    } as const satisfies WithContext<WebSite>)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-lora" preload />
    <ClientRouter />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
